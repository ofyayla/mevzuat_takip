# mevzuat-crawler — yerel çalıştırma için app/.env olarak kopyalayın (repoya eklenmez).
# Kurumda değerler chart values (envVars) + Secret veya DMZ'de /etc/mevzuat/crawler.env ile verilir.
TZ=Europe/Istanbul
LOG_LEVEL=INFO
# Crawler kullanıcısı: yalnızca mevzuat_crawl'a yazabilir, silemez
MONGO_URL=mongodb://localhost:27017
MONGO_DB=mevzuat_crawl
CRAWLER_MAX_PARALLEL=3
CRAWLER_POLL_S=15
# Kurum çıkış proxy'si ve (SSL denetimi varsa) kök sertifika paketi
HTTPS_PROXY=
CA_BUNDLE=
HTTP_USER_AGENT=MevzuatTakipBot/1.0 (+Mevzuat ve Uyum Baskanligi)
COLLECT_REQUEST_DELAY_S=1.5
COLLECT_TIMEOUT_S=30
COLLECT_MAX_ATTACHMENTS=5
