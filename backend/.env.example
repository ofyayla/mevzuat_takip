# Mevzuat Takip Otomasyonu — Backend konfigürasyonu
# Bu dosyayı backend/.env olarak kopyalayın ve değerleri doldurun. backend/.env repoya eklenmez.

# ---------- Uygulama ----------
# local | test | prod
APP_ENV=local
TZ=Europe/Istanbul
LOG_LEVEL=INFO

# ---------- LLM ----------
# Yerel geliştirme: OpenAI API. Kurum ortamı: vLLM (OpenAI uyumlu).
# openai | vllm
LLM_PROVIDER=openai
# <-- OpenAI API anahtarınızı buraya girin (vllm için: EMPTY)
LLM_API_KEY=
# openai için boş; vllm: http://10.144.100.204:8806/v1
LLM_BASE_URL=
# vllm: Qwen/Qwen3.6-35B-A3B-FP8
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_S=120
LLM_MAX_CONCURRENCY=2
# yalnızca vllm (Qwen thinking) için anlamlı
LLM_ENABLE_THINKING=true
LLM_THINKING_TASKS=relevance,severity,summary,unit_match
# thinking çıktısını llm_call tablosunda sakla
LLM_STORE_REASONING=false
# json_schema (varsayılan, guided decoding) | json_object (sunucu şema zorlamasını desteklemiyorsa)
LLM_JSON_MODE=json_schema

# ---------- İlgililik / önem (İK-3) — başlangıç değerleri; çalışma zamanında `mevzuat-ai setting` ile ezilir ----------
RELEVANCE_THRESHOLD=0.30
RELEVANCE_SAMPLES=3
RELEVANCE_WEIGHT_MODEL=0.6
RELEVANCE_WEIGHT_VOTES=0.3
RELEVANCE_WEIGHT_RULES=0.1
CONFIDENCE_HIGH=0.75
CONFIDENCE_MEDIUM=0.45
# Not: LLM_PROVIDER=openai iken KEP kaynağı otomatik olarak devre dışıdır (kurum içi yazışma dışarı gönderilmez).

# ---------- Veritabanı / Kuyruk ----------
# Boş bırakılırsa yerel SQLite (backend/data/mevzuat.db). Üretim:
# DATABASE_URL=postgresql+psycopg://mevzuat:mevzuat@localhost:5432/mevzuat
DATABASE_URL=
# kurumdaki Redis (ör. redis://redis.kurum.local:6379/0); boşsa dosya kilidi
REDIS_URL=

# ---------- Depolama ----------
# boşsa backend/data/raw; üretim: /data/raw
RAW_STORAGE_DIR=
KEP_INBOX_DIR=/data/kep_inbox

# ---------- Toplama ----------
# kurum proxy/DMZ çıkışı (ör. http://proxy.kurum.local:8080); boşsa ortamdaki değer
HTTPS_PROXY=
# kurum kök sertifikası (SSL denetimi yapan proxy için); boşsa sistem deposu
CA_BUNDLE=
# zincirini eksik gönderen sunucuların ara sertifikaları (BDDK, RG, mevzuat.gov.tr); boşsa backend/config/certs
# güncellemek için: mevzuat-collect ca-fetch <host>
EXTRA_CA_DIR=
HTTP_USER_AGENT=MevzuatTakipBot/1.0 (+Mevzuat ve Uyum Baskanligi)
# host başına istekler arası bekleme (kaynak bazında sources.yaml'da ezilebilir)
COLLECT_REQUEST_DELAY_S=1.5
COLLECT_TIMEOUT_S=30
COLLECT_MAX_ATTACHMENTS=5
COLLECT_DEFAULT_LOOKBACK_DAYS=30

# ---------- Belge işleme / OCR (İK-2) ----------
# none | azure_di  (kurumdaki Azure Document Intelligence "Read" servisi)
OCR_PROVIDER=none
# ör. https://docintel.kurum.local  (bulut kaynağında https://<ad>.cognitiveservices.azure.com)
OCR_ENDPOINT=
# Ocp-Apim-Subscription-Key; anahtar istemeyen kurum içi kurulumda boş
OCR_API_KEY=
# v4.0: 2024-11-30 + documentintelligence ; v3.x kurulumu: 2023-07-31 + formrecognizer
OCR_API_VERSION=2024-11-30
OCR_PATH_PREFIX=documentintelligence
OCR_MODEL=prebuilt-read
OCR_LOCALE=tr-TR
OCR_TIMEOUT_S=180
# metin katmanı bundan az karakterli sayfalar OCR'a gider
OCR_MIN_CHARS_PER_PAGE=40
# ilk taramadaki eski belgeler de OCR'a gönderilsin mi
OCR_BASELINE=false
DEDUPE_AUTO_THRESHOLD=0.90
DEDUPE_REVIEW_THRESHOLD=0.70

# ---------- Kimlik doğrulama ----------
# disabled (demo) | keycloak
AUTH_MODE=disabled
DEMO_USER_NAME=Demo Kullanıcı
DEMO_USER_TITLE=Uyum Uzmanı
# ör. https://sso.kurum.local/realms/banka
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=mevzuat-portal
# realm RS256 public key(ler)i (.pem), backend Keycloak'a bağlanmaz
KEYCLOAK_PUBLIC_KEYS_DIR=./config/keycloak_keys

# ---------- Portal ----------
CORS_ORIGINS=http://localhost:8080
