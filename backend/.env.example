# Mevzuat Takip Otomasyonu — Backend konfigürasyonu
# Bu dosyayı backend/.env olarak kopyalayın ve değerleri doldurun. backend/.env repoya eklenmez.

# ---------- Uygulama ----------
APP_ENV=local                    # local | test | prod
TZ=Europe/Istanbul
LOG_LEVEL=INFO

# ---------- LLM ----------
# Yerel geliştirme: OpenAI API. Kurum ortamı: vLLM (OpenAI uyumlu).
LLM_PROVIDER=openai              # openai | vllm
LLM_API_KEY=                     # <-- OpenAI API anahtarınızı buraya girin (vllm için: EMPTY)
LLM_BASE_URL=                    # openai için boş; vllm: http://10.144.100.204:8806/v1
LLM_MODEL=gpt-4.1-mini           # vllm: Qwen/Qwen3.6-35B-A3B-FP8
LLM_TIMEOUT_S=120
LLM_MAX_CONCURRENCY=2
LLM_ENABLE_THINKING=true         # yalnızca vllm (Qwen thinking) için anlamlı
LLM_THINKING_TASKS=relevance,severity,summary,unit_match
LLM_STORE_REASONING=false        # thinking çıktısını llm_call tablosunda sakla
# Not: LLM_PROVIDER=openai iken KEP kaynağı otomatik olarak devre dışıdır (kurum içi yazışma dışarı gönderilmez).

# ---------- Veritabanı / Kuyruk ----------
DATABASE_URL=postgresql+psycopg://mevzuat:mevzuat@localhost:5432/mevzuat
REDIS_URL=redis://localhost:6379/0   # kurumda mevcut Redis adresi

# ---------- Depolama ----------
RAW_STORAGE_DIR=/data/raw
KEP_INBOX_DIR=/data/kep_inbox

# ---------- Toplama ----------
HTTPS_PROXY=                     # kurum proxy/DMZ çıkışı (ör. http://proxy.kurum.local:8080)
HTTP_USER_AGENT=MevzuatTakipBot/1.0 (+Mevzuat ve Uyum Baskanligi)
COLLECT_REQUEST_DELAY_S=1.5

# ---------- Kimlik doğrulama ----------
AUTH_MODE=disabled               # disabled (demo) | keycloak
DEMO_USER_NAME=Demo Kullanıcı
DEMO_USER_TITLE=Uyum Uzmanı
KEYCLOAK_ISSUER=                 # ör. https://sso.kurum.local/realms/banka
KEYCLOAK_CLIENT_ID=mevzuat-portal
KEYCLOAK_PUBLIC_KEYS_DIR=./config/keycloak_keys   # realm RS256 public key(ler)i (.pem), backend Keycloak'a bağlanmaz

# ---------- Portal ----------
CORS_ORIGINS=http://localhost:8080
