# Podman Quadlet (RHEL 9) — DMZ crawler'ı systemd servisi olarak çalıştırır.
#   sudo install -m 644 mevzuat-crawler.container /etc/containers/systemd/
#   sudo install -m 600 crawler.env.example /etc/mevzuat/crawler.env   # değerleri doldurun
#   sudo systemctl daemon-reload && sudo systemctl start mevzuat-crawler
#   journalctl -u mevzuat-crawler -f
[Unit]
Description=Mevzuat Takip DMZ crawler
Wants=network-online.target
After=network-online.target

[Container]
Image=10.54.62.31:9099/com.albaraka.ai/mevzuat-crawler:latest
ContainerName=mevzuat-crawler
EnvironmentFile=/etc/mevzuat/crawler.env
Volume=mevzuat-crawler-data:/data
HealthCmd=mevzuat-crawler healthcheck
HealthInterval=60s
HealthOnFailure=kill
NoNewPrivileges=true
ReadOnly=true
Tmpfs=/tmp
# Sabit host adı: Podman varsayılanı her yeniden oluşturmada değişen konteyner kimliğidir; crawler bu adla kilit ve
# talep sahipliği tutar (kalıntı temizliği host adı değişse de çalışır, ama sabit ad kurtarmayı hemen yapar).
# --stop-timeout: TimeoutStopSec'ten (150) küçük olmalı; SIGTERM sonrası süren taramalar bu sürede temiz kapanır.
# --memory: sınırsız bellek aşımında konteyner değil sunucu OOM'a düşer. Sınır, 3 eşzamanlı kaynak × en çok
# COLLECT_MAX_BYTES (50 MB) indirmeye ve ayrıştırma payına göre bol seçildi; izleyip gerekirse ayarlayın.
# Quadlet anahtarları (HostName=, StopTimeout=, Memory=) sürüme bağlı olduğundan PodmanArgs kullanılır:
# desteklenmeyen bir anahtar unit'in hiç üretilmemesine yol açar.
PodmanArgs=--hostname=mevzuat-crawler --stop-timeout=140 --memory=1g

[Service]
Restart=always
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
