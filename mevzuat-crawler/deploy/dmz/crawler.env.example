# DMZ crawler (192.168.18.35) ortam değişkenleri → /etc/mevzuat/crawler.env (izin: 600, sahibi root)
# Bu makinede LLM/OCR/PostgreSQL/Redis ayarı YOKTUR; yalnızca internete (443) ve MongoDB'ye (27017) erişir.
TZ=Europe/Istanbul
LOG_LEVEL=INFO
# Crawler kullanıcısı (deploy/mongo/init-users.js → mevzuat_crawler): yalnızca mevzuat_crawl veritabanı
MONGO_URL=mongodb://mevzuat_crawler:DEGISTIR@10.155.7.195:27017/?authSource=admin
MONGO_DB=mevzuat_crawl
CRAWLER_MAX_PARALLEL=3
CRAWLER_POLL_S=15
# Kurum çıkış proxy'si varsa (yoksa boş bırakın)
HTTPS_PROXY=
# SSL denetimi yapan proxy için kurum kök sertifikası (konteyner içindeki yol)
CA_BUNDLE=
HTTP_USER_AGENT=MevzuatTakipBot/1.0 (+Mevzuat ve Uyum Baskanligi)
COLLECT_REQUEST_DELAY_S=1.5
